# Base URL of the backend API (without the trailing /api).
# The RTK Query base query appends `/api` and Socket.IO connects to this origin.
VITE_API_URL=http://localhost:5000

# Canonical site URL, used for SEO tags (Open Graph / Twitter / canonical).
VITE_SITE_URL=http://localhost:5173

# ============ XƏRİTƏ ============
# auto: Google açarı varsa Google, yoxdursa / yüklənməsə Leaflet (OSM) | google | leaflet
VITE_MAP_PROVIDER=auto
# Google Maps JavaScript API + Places API (New) (+ isteğe bağlı Geocoding API)
# Açarı HTTP referrer ilə məhdudlaşdırın: http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=
# Advanced Markers üçün Map ID (boşdursa DEMO_MAP_ID)
VITE_GOOGLE_MAP_ID=
# CARTO basemaps (Leaflet xəritəsinin əsas plitələri). Açar URL-lərə ?key=… kimi əlavə olunur.
# Brauzerdə görünən açardır — CARTO panelində domenlə (localhost, sizin domen) məhdudlaşdırın.
# Repo açıqdırsa, açarı buradan silib yalnız .env-də saxlayın.
VITE_CARTO_API_KEY=cb1_4yyc_1_714b46abdfdf721e11cf65b9
# Raster plitə şablonları (işıqlı / qaranlıq rejim)
VITE_CARTO_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
VITE_CARTO_TILE_URL_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# Vektor stil (MapLibre GL üçün; hazırda istifadə olunmur — Leaflet raster plitələrlə işləyir)
VITE_CARTO_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json

# İsteğe bağlı: Mapbox plitələri (fallback zəncirində CARTO açarından sonra)
VITE_MAPBOX_TOKEN=
