# ============ SERVER ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
MONGODB_URI=mongodb://localhost:27017/smart_transit
DB_HOST=localhost
DB_NAME=smart_transit
DB_USERNAME=
DB_PASSWORD=
DB_CLUSTER_NAME=

# ============ AUTH SECRETS (use strong random values in production) ============
ACCESS_SECRET_KEY=change_me_access_secret_min_32_chars
REFRESH_SECRET_KEY=change_me_refresh_secret_min_32_chars
ENCRYPTION_KEY=change_me_32_character_encryption_key

# ============ URLS / DOMAIN ============
DOMAIN=localhost
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ============ SMTP (email delivery) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ============ DEFAULT ACCOUNTS (created on first boot) ============
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!
# Demo dispetçer (operator rolu)
DEFAULT_OPERATOR_EMAIL=operator@example.com
DEFAULT_OPERATOR_PASSWORD=Operator123!

# ============ AI (OpenRouter) — optional ============
# Boş qalsa AI funksiyaları qayda əsaslı rejimdə işləyir (chatbot, xülasə, tövsiyə izahı).
OPENROUTER_API_KEY=
# Sürətli model (xülasə + chatbot; tool calling dəstəkləməlidir). Cari ID-ləri openrouter.ai/models-də yoxlayın.
OPENROUTER_MODEL=google/gemini-3.5-flash
# Daha güclü model (dispetçer tövsiyəsinin izahı). Boşdursa OPENROUTER_MODEL istifadə olunur.
OPENROUTER_REASONING_MODEL=
AI_TIMEOUT_MS=20000

# ============ GEMINI — operator proqnozu (/api/analytics/predict) ============
# Google AI Studio açarı. Boş qalsa proqnoz deterministik modellə hazırlanır.
# Açarı yalnız .env-də saxlayın (git-ə düşən fayllara yazmayın).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model tapılmasa (404) istifadə olunan alias
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=25000
PREDICT_CACHE_SEC=180

# ============ HAVA (Open-Meteo, açar tələb etmir) ============
WEATHER_ENABLED=true
WEATHER_LAT=40.4093
WEATHER_LNG=49.8671
WEATHER_CACHE_MIN=10

# ============ SMART TRANSIT ============
# Simulyator (real GPS olmadıqda)
SIM_ENABLED=true
SIM_TICK_MS=2000
SIM_AVG_SPEED_KMH=22
SIM_DWELL_SEC=25

# Crowdsourcing sıxlığı
CROWD_LOOKBACK_MIN=15
CROWD_HALF_LIFE_MIN=5
VERIFY_RADIUS_M=300
REPORT_COOLDOWN_SEC=60
# Göstərilən sıxlıq və sərnişin sayı xam datadan bu qədər % çox (ehtiyat payı).
# Sərnişin, operator paneli, AI və dispetçer tövsiyəsi eyni rəqəmi görür; anomaliya qaydası xam bildirişlərlə işləyir.
# 0 → xam dəyərlər.
CROWD_DISPLAY_BOOST_PCT=20

# Anomaliya: son ANOMALY_WINDOW_MIN dəq-də ≥ANOMALY_MIN_HIGH unikal "Yüksək" və ≥ANOMALY_MIN_RATIO pay
ANOMALY_WINDOW_MIN=10
ANOMALY_MIN_HIGH=3
ANOMALY_MIN_RATIO=0.6
ANOMALY_CHECK_SEC=20
# Sybil qorunması: eyni şəbəkə mənbəyindən (IP hash) ən çox neçə cihaz sayılsın
ANOMALY_MAX_DEVICES_PER_IP=2

# Marşrut planlayıcı + isteğe bağlı Google Routes API (server açarı)
PLANNER_MAX_WALK_M=1200
PLANNER_TRANSFER_WALK_M=350
GOOGLE_ROUTES_API_KEY=

# Yanaşma A — proaktiv tələb
DEMAND_INTENT_TTL_MIN=45
DEMAND_RADIUS_M=500
DEMAND_HORIZON_MIN=30
DEMAND_ALERT_MIN=15

# Yanaşma B — canlı lokasiya (production üçün PRESENCE_MIN_CELL=3+)
PRESENCE_TTL_SEC=90
PRESENCE_CELL_DEG=0.0015
PRESENCE_MIN_CELL=1
PRESENCE_STOP_RADIUS_M=70
PRESENCE_BUS_RADIUS_M=60

# Dispetçer tövsiyəsi
BUS_CAPACITY=100
TARGET_LOAD=0.85
MAX_RESERVE_PER_ALERT=3

# Demo alətləri (saxta bildiriş/anomaliya). Boş buraxılsa: development-də açıq, production-da bağlı
DEMO_ENABLED=true

# JSON sorğu gövdəsinin maksimum ölçüsü (DoS qorunması)
JSON_PAYLOAD_LIMIT=100kb
